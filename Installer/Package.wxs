<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Per-user MSI: installs to %LocalAppData%\Programs\Audio Reactor, needs no administrator rights.
       Settings, library and logs live in %AppData%\AudioReactor and are preserved on upgrade and uninstall. -->
  <Package Name="Audio Reactor" Manufacturer="Audio Reactor" Version="$(var.Version)" Language="1033"
           UpgradeCode="B7D9C2A4-5E1F-4C86-9A33-7F2E0B6D1C58" Scope="perUser" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Audio Reactor is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/unupunct/Audio-Reactor" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/unupunct/Audio-Reactor" />

    <!-- Dependency check: the visualizer needs the Microsoft Edge WebView2 Runtime (built into Windows 11, present on most Windows 10). -->
    <Property Id="WEBVIEW2_MACHINE">
      <RegistrySearch Id="Wv2Machine" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="WEBVIEW2_USER">
      <RegistrySearch Id="Wv2User" Root="HKCU" Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
    </Property>
    <Launch Condition="Installed OR WEBVIEW2_MACHINE OR WEBVIEW2_USER"
            Message="Audio Reactor needs the Microsoft Edge WebView2 Runtime. Install it from https://developer.microsoft.com/microsoft-edge/webview2/ and run this setup again." />
    <Launch Condition="VersionNT64" Message="Audio Reactor requires a 64-bit version of Windows 10 or Windows 11." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Audio Reactor" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Audio Reactor" Description="The application." Level="1" AllowAbsent="no" Display="expand">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Description="Add a shortcut to the desktop." Level="2" AllowAbsent="yes">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="StartMenuLnk" Name="Audio Reactor" Description="Music player, radio and audio-reactive visuals" Target="[INSTALLFOLDER]AudioReactor.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\AudioReactor" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="DesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="DesktopLnk" Name="Audio Reactor" Target="[INSTALLFOLDER]AudioReactor.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU" Key="Software\AudioReactor" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
  </Package>
</Wix>
